<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050005">

    <com.willi.app.ui.JarvisView
        android:id="@+id/jarvisViewSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WILLI"
            android:textColor="#FF1744"
            android:textSize="80sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTELLIGENCE ARTIFICIELLE v1.0"
            android:textColor="#CC1122"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IRON SHIELD PROTOCOL"
            android:textColor="#660011"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="INITIALISATION DU SYSTÈME..."
        android:textColor="#CC1122"
        android:textSize="14sp"
        android:fontFamily="monospace" />

</FrameLayout>
