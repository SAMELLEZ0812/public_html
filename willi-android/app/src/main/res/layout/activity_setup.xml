<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050005">

    <com.willi.app.ui.JarvisView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center">

            <TextView
                android:id="@+id/stepIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ÉTAPE 1/3"
                android:textColor="#660011"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INITIALISATION"
                android:textColor="#FF1744"
                android:textSize="32sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comment dois-je vous appeler ?"
                android:textColor="#CC1122"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:layout_marginBottom="48dp" />

            <!-- Étape 1: Nom -->
            <LinearLayout
                android:id="@+id/layoutName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Votre prénom"
                        android:textColor="#FFE4E4"
                        android:textColorHint="#660011"
                        android:fontFamily="monospace"
                        android:inputType="textPersonName"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Étape 2: Voix -->
            <LinearLayout
                android:id="@+id/layoutVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prêt à enregistrer"
                    android:textColor="#FF5252"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="16dp" />

                <ProgressBar
                    android:id="@+id/progressVoice"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progressTint="#CC1122"
                    android:max="100"
                    android:progress="0"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

            <!-- Étape 3: API Key -->
            <LinearLayout
                android:id="@+id/layoutApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etApiKey"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="sk-ant-api03-..."
                        android:textColor="#FFE4E4"
                        android:textColorHint="#660011"
                        android:fontFamily="monospace"
                        android:inputType="textPassword"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clé disponible sur console.anthropic.com"
                    android:textColor="#660011"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CONTINUER"
                android:textColor="#FFE4E4"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:backgroundTint="#CC1122"
                android:layout_marginTop="16dp" />

            <Button
                android:id="@+id/btnSkipVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Passer cette étape"
                android:textColor="#660011"
                android:fontFamily="monospace"
                android:background="@null"
                android:visibility="gone"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
